{# gallery imgPath - "/images/jpg/top/gallery.jpg" #}

{% macro bannerTitleText( titleBanner, textBanner, imgPath ) %}
  <img class="banner-title-text" src="{{ imgPath }}" alt="gallery top banner"/>

  <div class="banner-title-text-content">
    <div class="banner-title-text-content__title">
      <!-- title( heading, classTitle, title ) -->
      {% from "src/partials/ui/title.njk" import title %}
      {{ title( "h1", "title_h1 title_spacing title_white", titleBanner ) }}
    </div>
    <div class="banner-title-text-content__text">
      <!-- text( classText, text ) -->
      {% from "src/partials/ui/text.njk" import text %}
      {{ text( "text_top text_white", textBanner ) }}
    </div>
  </div>

{% endmacro %}
