{# classContent - 1: produce-image__content_about #}

{% macro produceImage( imagePath, classContent ) %}
  <section class="produce-image">
    <img class="produce-image__img" src="{{ imagePath }}" alt="eco produce" />

    <div class="produce-image__content {{ classContent }}">
      <svg class="produce-image__icon">
        <use href="/images/sprites.svg#eco-icon"></use>
      </svg>

      <div class="produce-image__title">
        <!-- title( heading, classTitle, title ) -->
        {% from "src/partials/ui/title.njk" import title %}
        {{ title( "h2", "title_h2 title_white", "Эко продукция") }}
      </div>

      <div class="produce-image__text">
        <!-- text( classText, text ) -->
        {% from "src/partials/ui/text.njk" import text %}
        {{ text( "text_eco text_white", "Выращиваем каждое деревцо с любовью, на экологически 
        чистой земле, без использования пестицидов и химии") }}
      </div>
    </div>
  </section>
{% endmacro %}
